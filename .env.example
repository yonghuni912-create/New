# Environment Variables

# Database
DATABASE_URL="file:./dev.db"
# For production with Turso (Main App)
# TURSO_DATABASE_URL="libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN="your-auth-token"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# BBQ Command Center Turso (for Sales Reports & Analytics)
# COMMAND_CENTER_TURSO_URL="libsql://your-command-center-db.turso.io"
# COMMAND_CENTER_TURSO_TOKEN="your-turso-token"

# Metabase API (for Analytics Dashboard)
# METABASE_URL="http://localhost:3000"  # Local Metabase instance
# METABASE_API_KEY="mb_your_api_key_here"
# METABASE_DATABASE_ID="290"  # Database ID in Metabase

# Legacy Metabase Embedding (deprecated - use API instead)
# METABASE_DASHBOARD_ID="your-public-dashboard-id"
# METABASE_SECRET_KEY="your-embedding-secret-key"

# File Storage (optional, for S3)
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="your-bucket-name"

# OpenTelemetry Tracing (optional)
# OTEL_SERVICE_NAME="bbq-franchise-platform"
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_TRACES_ENABLED="true"

# Node Environment
NODE_ENV="development"
